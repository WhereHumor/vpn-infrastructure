{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{ xray_uuid }}",
            "flow": "xtls-rprx-vision",
            "email": "user1-tcp@proxy"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "dest": "{{ xray_dest }}",
          "serverNames": ["{{ xray_server_name }}"],
          "privateKey": "{{ xray_private_key }}",
          "shortIds": ["{{ xray_short_id }}"]
        }
      }
    },
    {
      "port": 8443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{ xray_uuid }}",
            "email": "user1-xhttp@proxy"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "dest": "{{ xray_dest }}",
          "serverNames": ["{{ xray_server_name }}"],
          "privateKey": "{{ xray_private_key }}",
          "shortIds": ["{{ xray_short_id }}"]
        },
        "xhttpSettings": {
          "path": "/xhttp",
          "mode": "auto"
        }
      }
    }
  ],
  "outbounds": [
    {"protocol": "freedom", "tag": "direct"},
    {"protocol": "blackhole", "tag": "block"}
  ]
}
